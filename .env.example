# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server & Session
PORT=3000
DATABASE_URL="sqlite://./data/kidora.db"
SESSION_SECRET="kidora_super_secret_session_key_production"
JWT_SECRET="kidora_jwt_secret_token_signing_key_production"

# OAuth Authentication Providers
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
APPLE_CLIENT_ID="com.kidora.store.client"
APPLE_TEAM_ID="APPLE_TEAM_ID_EXAMPLE"
APPLE_KEY_ID="APPLE_KEY_ID_EXAMPLE"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...\n-----END PRIVATE KEY-----"

# Payment Gateway Providers
PAYMENT_PROVIDER_KEY="pk_live_kidora_public_key"
PAYMENT_PROVIDER_SECRET="sk_live_kidora_secret_key"
PAYMENT_WEBHOOK_SECRET="whsec_kidora_webhook_signing_secret"

# Transactional Email System
EMAIL_API_KEY="re_kidora_resend_api_key_example"
EMAIL_FROM="KIDORA Store <orders@kidora.com>"

